#include <iostream>
#include <vector>
#include <algorithm>

class Solution {
public:
    int removeElement(std::vector<int>& nums, int val) {
      std::sort(nums.begin(), nums.end()) ;
      nums.erase(std::find(nums.begin(), nums.end(), val), std::next(std::find(nums.rbegin(), nums.rend(),val).base(),  val))
      return nums.size() ;
    }
};





int main()
{
  std::vector<int> nums {0 , 1, 2 , 1 , 1, 3 ,4 };
  auto Solution sol{} ;
  auto print = [&] (std::vector & vec)
  {
    for (auto & a : vec)
      std::cout "Element : " << a << std::endl ;
  }
  auto x = sol.removeElement(nums, 2) ;
  
}
